  \entry{benavente_exploring_2023}{article}{}{}
    \name{author}{4}{}{%
      {{hash=BK}{%
         family={Benavente},
         familyi={B\bibinitperiod},
         given={Kevin},
         giveni={K\bibinitperiod},
      }}%
      {{hash=t}{%
         family={\textbf{Robbins, Eric W.}},
