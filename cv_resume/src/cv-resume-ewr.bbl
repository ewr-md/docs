    \field{shorttitle}{Improved Detection of Myositis‐Specific Autoantibodies
  Using Luciferase Immunoprecipitation Systems Assay}
    \field{title}{Improved Detection of Myositis‐Specific Autoantibodies
  Using Luciferase Immunoprecipitation Systems Assay: Comparison with Line Blot
  and Conventional Immunoprecipitation}
